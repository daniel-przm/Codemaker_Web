---
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    class="fixed left-1/2 -translate-x-1/2 z-[100] bg-slate-950/80 border border-white/10 backdrop-blur-xl transition-all duration-500 ease-in-out top-6 w-[95%] rounded-full px-6 py-2 md:py-3"
  >
    <div id="nav-row" class="flex justify-between items-center gap-4">
      <!-- Logo -->
      <a href="/" class="shrink-0 transition-transform hover:scale-105 active:scale-95">
        <img
          src="/svg/LogoInvertido.svg"
          alt="Codemaker Logo"
          class="h-5 md:h-6 w-auto object-contain"
        />
      </a>

      <!-- Navigation Links -->
      <div id="nav-links" class="flex items-center gap-4 sm:gap-8 md:gap-12 shrink-0">
        <!-- Home Link -->
        <a
          id="nav-home"
          href="/"
          class="shrink-0 flex flex-col items-center gap-1 text-slate-400 hover:text-white transition-all group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:scale-110"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span class="text-[10px] md:text-xs uppercase tracking-[0.15em] opacity-80 group-hover:opacity-100">Home</span>
        </a>

        <!-- Apps Link -->
        <a
          id="nav-apps"
          href="/#apps"
          class="shrink-0 flex flex-col items-center gap-1 text-slate-400 hover:text-white transition-all group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:scale-110"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
          <span class="text-[10px] md:text-xs uppercase tracking-[0.15em] opacity-80 group-hover:opacity-100">Apps</span>
        </a>

        <!-- Cursos Link -->
        <a
          id="nav-cursos"
          href="/#cursos"
          class="shrink-0 flex flex-col items-center gap-1 text-slate-400 hover:text-white transition-all group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:scale-110"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span class="text-[10px] md:text-xs uppercase tracking-[0.15em] opacity-80 group-hover:opacity-100">Cursos</span>
        </a>

        <!-- Blog Link -->
        <a
          id="nav-blog"
          href="/blog"
          class="shrink-0 flex flex-col items-center gap-1 text-slate-400 hover:text-white transition-all group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:scale-110"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span class="text-[10px] md:text-xs uppercase tracking-[0.15em] opacity-80 group-hover:opacity-100">Blog</span>
        </a>

        <!-- Entrar Link -->
        <a
          id="nav-entrar"
          href="https://3d.codemaker.es"
          class="shrink-0 flex flex-col items-center gap-1 text-slate-400 hover:text-[#007AFB] transition-all group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:scale-110"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          <span class="text-[10px] md:text-xs uppercase tracking-[0.15em] opacity-80 group-hover:opacity-100">Entrar</span>
        </a>

        <!-- Overflow "more" menu: filled by JS with links that don't fit -->
        <div id="nav-more-wrapper" class="relative shrink-0" hidden>
          <button
            id="nav-more-btn"
            type="button"
            class="flex flex-col items-center gap-1 text-slate-400 hover:text-white transition-all group"
            aria-label="Más opciones"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="transition-transform group-hover:scale-110">
              <circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/>
            </svg>
            <span class="text-[10px] md:text-xs uppercase tracking-[0.15em] opacity-80 group-hover:opacity-100">Más</span>
          </button>
          <div id="nav-more-menu" class="absolute top-full right-0 mt-3 min-w-[180px] bg-slate-950/95 border border-white/10 backdrop-blur-xl rounded-2xl p-2 shadow-2xl"></div>
        </div>
      </div>
    </div>
  </nav>
</div>

<!-- Modal: app no disponible en móvil -->
<div id="mobile-warning-modal" class="fixed inset-0 z-[200] hidden items-center justify-center p-6">
  <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm" id="mobile-warning-overlay"></div>
  <div
    id="mobile-warning-content"
    class="relative bg-slate-900 border border-white/10 w-full max-w-sm rounded-3xl shadow-2xl transform transition-all scale-95 opacity-0 duration-300 p-8 text-center"
  >
    <!-- Close button -->
    <button id="mobile-warning-close" class="absolute top-5 right-5 text-slate-500 hover:text-slate-300 transition-colors bg-slate-800 p-2 rounded-full hover:bg-slate-700" aria-label="Cerrar">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <!-- Icon -->
    <div class="flex items-center justify-center w-16 h-16 rounded-2xl bg-slate-800 border border-white/10 mx-auto mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#007AFB" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><circle cx="12" cy="17" r="1"/></svg>
    </div>

    <h3 class="text-xl font-bold text-white mb-3">App no disponible en móvil</h3>
    <p class="text-slate-400 text-sm leading-relaxed">
      Los editores de Codemaker están diseñados para pantallas grandes. Accede desde un <span class="text-white font-medium">ordenador o tablet</span> para disfrutar de la experiencia completa.
    </p>
  </div>
</div>

<style>
  #main-nav {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #main-nav.scrolling {
    background-color: rgba(0, 71, 122, 0.85);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.3);
  }

  #nav-more-menu {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
  }
  #nav-more-menu.open {
    display: flex;
  }
  #nav-more-menu a {
    flex-direction: row !important;
    justify-content: flex-start !important;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    border-radius: 0.85rem;
    width: 100%;
  }
  #nav-more-menu a:hover {
    background: rgba(255, 255, 255, 0.08);
  }
</style>

<script>
  const nav = document.getElementById("main-nav");

  function updateNav() {
    if (window.scrollY > 50) {
      nav?.classList.add("scrolling");
    } else {
      nav?.classList.remove("scrolling");
    }
  }

  window.addEventListener("scroll", updateNav, { passive: true });
  updateNav();

  // Priority navigation: hide links into a "..." overflow menu when they
  // don't all fit in the pill, restoring them as space becomes available.
  const navRow = document.getElementById("nav-row");
  const navLinks = document.getElementById("nav-links");
  const moreWrapper = document.getElementById("nav-more-wrapper");
  const moreBtn = document.getElementById("nav-more-btn");
  const moreMenu = document.getElementById("nav-more-menu");

  const NAV_ORDER = ["nav-home", "nav-apps", "nav-cursos", "nav-blog", "nav-entrar"];
  const HIDE_PRIORITY = ["nav-blog", "nav-cursos", "nav-apps"];

  function layoutNav() {
    if (!navRow || !navLinks || !moreWrapper || !moreMenu) return;

    // Restore every link to its original position before re-measuring.
    NAV_ORDER.forEach((id) => {
      const el = document.getElementById(id);
      if (el) navLinks.insertBefore(el, moreWrapper);
    });
    moreMenu.replaceChildren();
    moreWrapper.hidden = true;
    moreMenu.classList.remove("open");
    moreBtn?.setAttribute("aria-expanded", "false");

    for (const id of HIDE_PRIORITY) {
      if (navRow.scrollWidth <= navRow.clientWidth) break;
      const el = document.getElementById(id);
      if (!el) continue;
      moreWrapper.hidden = false;
      moreMenu.appendChild(el);
    }
  }

  let navResizeRAF: ReturnType<typeof requestAnimationFrame>;
  function scheduleNavLayout() {
    cancelAnimationFrame(navResizeRAF);
    navResizeRAF = requestAnimationFrame(layoutNav);
  }

  window.addEventListener("resize", scheduleNavLayout, { passive: true });
  scheduleNavLayout();

  moreBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = moreMenu?.classList.toggle("open");
    moreBtn.setAttribute("aria-expanded", String(!!isOpen));
  });

  document.addEventListener("click", (e) => {
    if (moreWrapper && !moreWrapper.contains(e.target as Node)) {
      moreMenu?.classList.remove("open");
      moreBtn?.setAttribute("aria-expanded", "false");
    }
  });

  // Mobile warning modal
  const modal = document.getElementById("mobile-warning-modal");
  const modalContent = document.getElementById("mobile-warning-content");
  const overlay = document.getElementById("mobile-warning-overlay");
  const closeBtn = document.getElementById("mobile-warning-close");
  const entrarLink = document.getElementById("nav-entrar");

  function openMobileWarning() {
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    setTimeout(() => {
      modalContent?.classList.remove("scale-95", "opacity-0");
      modalContent?.classList.add("scale-100", "opacity-100");
    }, 10);
    document.body.style.overflow = "hidden";
  }

  function closeMobileWarning() {
    modalContent?.classList.add("scale-95", "opacity-0");
    modalContent?.classList.remove("scale-100", "opacity-100");
    setTimeout(() => {
      modal?.classList.add("hidden");
      modal?.classList.remove("flex");
      document.body.style.overflow = "";
    }, 300);
  }

  entrarLink?.addEventListener("click", (e) => {
    // md breakpoint = 768px
    if (window.innerWidth < 768) {
      e.preventDefault();
      openMobileWarning();
    }
  });

  overlay?.addEventListener("click", closeMobileWarning);
  closeBtn?.addEventListener("click", closeMobileWarning);

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
      closeMobileWarning();
    }
  });
</script>
