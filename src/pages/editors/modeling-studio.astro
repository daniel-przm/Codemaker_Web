---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/nav.astro';
import Footer from '../../components/footer.astro';
import ContactModal from '../../components/ContactModal.astro';
---

<Layout title="Modeling Studio | Codemaker">
  <Nav />

  <main class="bg-white min-h-screen text-slate-900 font-sans">

    <!-- ═══ HERO ═══ -->
    <section class="pt-32 pb-20 px-6 sm:px-10 border-b border-slate-100 patron-puntos">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-12">

        <div class="flex-1 space-y-6">
          <div class="flex flex-wrap gap-2">
            <span class="chip chip-slate">10 – 16 años</span>
            <span class="chip chip-amber">Intermedio</span>
            <span class="chip chip-purple">3D</span>
          </div>
          <h1 class="text-4xl md:text-6xl font-black text-slate-900">
            Modeling <span class="text-[#007AFB]">Studio</span>
          </h1>
          <p class="text-xl text-slate-600 leading-relaxed font-medium max-w-xl">
            El pilar del diseño 3D en la suite. Construye modelos geométricos precisos con operaciones booleanas y genera planos técnicos profesionales en PDF.
          </p>
        </div>

        <div class="flex-1 w-full md:max-w-lg">
          <div class="relative rounded-2xl p-[2px] shiny-border-3d shadow-2xl">
            <div class="rounded-[0.9rem] overflow-hidden bg-slate-950 aspect-video">
              <img src="/images/modelingstudio.png" alt="Modeling Studio" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ═══ QUÉ ES ═══ -->
    <section class="py-20 px-6 sm:px-10 border-b border-slate-100">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="section-title">¿Qué es Modeling Studio?</h2>
        <div class="w-16 h-1 bg-[#007AFB] mx-auto rounded-full"></div>
        <p class="text-lg text-slate-600 leading-relaxed">
          Modeling Studio es el editor de modelado 3D geométrico de Codemaker3D, basado en <strong class="text-slate-800">Geometría Sólida Constructiva (CSG)</strong>. Los alumnos combinan y operan sobre primitivas geométricas —cubos, esferas, cilindros, conos— con materiales y texturas. Su función más diferenciadora: generar <strong class="text-slate-800">planos técnicos profesionales</strong> con acotación, cuatro vistas normalizadas y exportación a PDF, igual que en software CAD real.
        </p>
      </div>
    </section>

    <!-- ═══ FUNCIONALIDADES ═══ -->
    <section class="py-20 px-6 sm:px-10 bg-slate-50">
      <div class="max-w-5xl mx-auto space-y-12">
        <h2 class="section-title text-center">Funcionalidades principales</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <div class="feature-card">
            <img src="/images/FeaturesStudios/Modeling_Figuras.png" alt="Primitivas y operaciones booleanas" class="feature-img" loading="lazy" />
            <div class="feature-content">

              <h3 class="feature-title">Primitivas y operaciones booleanas</h3>
              <p class="feature-desc">Cubo, esfera, cilindro, cono, pirámide, prisma y toroide. Operaciones CSG de unión, sustracción e intersección para crear geometrías complejas a partir de formas simples.</p>
            </div>
          </div>

          <div class="feature-card">
            <img src="/images/FeaturesStudios/Modeling_Gizmos.png" alt="Transformaciones con Gizmos 3D" class="feature-img" loading="lazy" />
            <div class="feature-content">

              <h3 class="feature-title">Transformaciones con Gizmos 3D</h3>
              <p class="feature-desc">Mover, rotar y escalar con controles visuales interactivos (TransformControls). Snap a rejilla configurable para alineación precisa, y modo hueco para ver el interior de las composiciones.</p>
            </div>
          </div>

          <div class="feature-card">
            <img src="/images/FeaturesStudios/Modeling_Texturas.png" alt="Materiales y 8 texturas" class="feature-img" loading="lazy" />
            <div class="feature-content">

              <h3 class="feature-title">Materiales y 8 texturas</h3>
              <p class="feature-desc">Paleta de 10 colores con selector libre. Texturas predefinidas: madera, piedra, metal, tela, césped, cristal, asfalto y teja. Escenarios de iluminación oscuro y claro.</p>
            </div>
          </div>

          <div class="feature-card feature-card-highlight">
            <img src="/images/FeaturesStudios/Modeling_Planos.png" alt="Planos técnicos profesionales" class="feature-img" loading="lazy" />
            <div class="feature-content">

              <h3 class="feature-title">
                Planos técnicos profesionales
              </h3>
              <p class="feature-desc">4 vistas simultáneas (alzado, perfil, planta, perspectiva), acotación con snapping a vértices, escalas normalizadas CAD (1:1 a 1:100) y cajetín profesional. Exportación a PDF A4 o PNG.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ VALOR PEDAGÓGICO ═══ -->
    <section class="py-20 px-6 sm:px-10 bg-white">
      <div class="max-w-5xl mx-auto space-y-14">
        <div class="text-center space-y-3">
          <h2 class="section-title">Valor pedagógico</h2>
          <p class="text-slate-500 max-w-2xl mx-auto">Competencias curriculares que trabaja este editor, alineadas con los objetivos de Tecnología y Matemáticas en ESO y Bachillerato.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

          <div class="pedagogy-card">
            <div class="pedagogy-icon bg-blue-50 text-[#007AFB] border-blue-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6l9 6 9-6-9-6-9 6z"/><path d="M3 18l9 6 9-6-9-6-9 6z"/></svg>
            </div>
            <h4 class="pedagogy-title">Geometría aplicada</h4>
            <p class="pedagogy-desc">Volúmenes, áreas, ejes de coordenadas y simetrías se convierten en conceptos tangibles. El error matemático es visible al instante en el modelo 3D, creando un bucle de aprendizaje inmediato.</p>
          </div>

          <div class="pedagogy-card">
            <div class="pedagogy-icon bg-emerald-50 text-emerald-600 border-emerald-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.77 3.77Z"/></svg>
            </div>
            <h4 class="pedagogy-title">Pensamiento de diseño</h4>
            <p class="pedagogy-desc">Idear, prototipar y validar: el ciclo del Design Thinking en acción. El alumno pasa de consumidor de tecnología a creador de soluciones con intención funcional y estética.</p>
          </div>

          <div class="pedagogy-card">
            <div class="pedagogy-icon bg-purple-50 text-purple-600 border-purple-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M3 9h18M3 15h18"/></svg>
            </div>
            <h4 class="pedagogy-title">Dibujo técnico ISO</h4>
            <p class="pedagogy-desc">El módulo de planos cubre los contenidos curriculares de Tecnología en ESO: vistas normalizadas, sistema europeo/americano de proyección, cotas y escalas según norma ISO 128.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="py-20 px-6 sm:px-10 bg-slate-100">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-3xl md:text-4xl font-black text-slate-900 leading-tight">
          Incorpora el diseño 3D y el dibujo técnico a tu aula
        </h2>
        <p class="text-lg text-slate-600">
          Nuestro equipo puede explicarte cómo Modeling Studio encaja en el currículo de Tecnología o Ingeniería y ayudarte con la puesta en marcha.
        </p>
        <button class="contact-trigger btn-primary">
          Contacta con nosotros
        </button>
      </div>
    </section>

  </main>

  <Footer />
  <ContactModal />
</Layout>

<style>
  .section-title    { @apply text-3xl md:text-4xl font-black text-slate-900; }

  .chip             { @apply px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border; }
  .chip-slate       { @apply bg-slate-100 text-slate-600 border-slate-200; }
  .chip-emerald     { @apply bg-emerald-50 text-emerald-700 border-emerald-100; }
  .chip-amber       { @apply bg-amber-50 text-amber-700 border-amber-100; }
  .chip-rose        { @apply bg-rose-50 text-rose-700 border-rose-100; }
  .chip-purple      { @apply bg-purple-50 text-purple-600 border-purple-100; }
  .chip-indigo      { @apply bg-indigo-50 text-indigo-600 border-indigo-100; }
  .chip-blue        { @apply bg-blue-50 text-[#007AFB] border-blue-100; }

  .btn-primary      { @apply inline-flex items-center justify-center px-8 py-4 rounded-2xl bg-[#007AFB] text-white font-bold hover:bg-[#00477A] transition-all shadow-lg shadow-blue-100 active:scale-95 text-lg; }
  .btn-primary-inv  { @apply inline-flex items-center justify-center px-10 py-5 rounded-2xl bg-white text-[#007AFB] font-black hover:bg-slate-100 transition-all shadow-xl active:scale-95 text-xl; }

  .feature-card           { @apply bg-white rounded-2xl border border-slate-200 p-5 flex gap-5 items-start hover:shadow-md transition-shadow; }
  .feature-card-highlight { @apply border-[#007AFB]/40 ring-1 ring-[#007AFB]/20; }
  .feature-img            { @apply w-28 h-28 object-cover rounded-xl flex-shrink-0; }
  .feature-content        { @apply flex flex-col gap-1 min-w-0; }
  .feature-num            { @apply block text-xs font-black uppercase tracking-widest text-[#007AFB]; }
  .feature-title          { @apply text-lg font-bold text-slate-900; }
  .feature-desc           { @apply text-slate-600 leading-relaxed text-sm; }

  .pedagogy-card  { @apply space-y-4 text-center; }
  .pedagogy-icon  { @apply size-16 rounded-2xl flex items-center justify-center mx-auto border; }
  .pedagogy-title { @apply text-xl font-bold text-slate-900; }
  .pedagogy-desc  { @apply text-slate-600 leading-relaxed text-sm; }

  .patron-puntos {
    background-image: radial-gradient(rgba(0,122,251,0.10) 1.5px, transparent 1.5px);
    background-size: 20px 20px;
  }
  .shiny-border-3d {
    background: linear-gradient(135deg, #64748b 10%, #C084FC 90%);
    background-size: 400%;
    animation: shine 6s linear infinite;
  }
  @keyframes shine {
    0%        { background-position: 100% 50%; }
    30%, 70%  { background-position:   0% 50%; }
    100%      { background-position: 100% 50%; }
  }
</style>
