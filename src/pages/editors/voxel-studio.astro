---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContactModal from '../../components/ContactModal.astro';
---

<Layout title="Voxel Studio">
  <Nav />

  <main class="bg-white min-h-screen text-slate-900 font-sans">

    <!-- ═══ HERO ═══ -->
    <section class="pt-32 pb-20 px-6 sm:px-10 border-b border-slate-100 patron-puntos">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-12">

        <div class="flex-1 space-y-6">
          <div class="flex flex-wrap gap-2">
            <span class="chip chip-purple">Diseño 3D</span>
            <span class="chip chip-emerald">iniciación</span>
          </div>
          <h1 class="text-4xl md:text-6xl font-black text-slate-900">
            Voxel <span class="text-[#007AFB]">Studio</span>
          </h1>
          <p class="text-xl text-slate-600 leading-relaxed font-medium max-w-xl">
            Crea mundos increíbles bloque a bloque. La herramienta más divertida e intuitiva para dar los primeros pasos en el diseño 3D.
          </p>
        </div>

        <div class="flex-1 w-full md:max-w-lg">
          <div class="relative rounded-2xl p-[2px] shiny-border-3d shadow-2xl">
            <div class="rounded-[0.9rem] overflow-hidden bg-slate-950 aspect-video">
              <img src="/images/voxelstudio.png" alt="Voxel Studio" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ═══ QUÉ ES ═══ -->
    <section class="py-20 px-6 sm:px-10 border-b border-slate-100">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="section-title">¿Qué es Voxel Studio?</h2>
        <div class="w-16 h-1 bg-[#007AFB] mx-auto rounded-full"></div>
        <p class="text-lg text-slate-600 leading-relaxed">
          Voxel Studio es un entorno de construcción 3D por bloques inspirado en mecánicas de juegos como Minecraft. Los alumnos colocan y eliminan cubos de colores sobre una cuadrícula tridimensional para construir estructuras, esculturas y paisajes. Sin complejidad técnica, el foco está totalmente en la <strong class="text-slate-800">creatividad espacial</strong> desde los primeros cursos de Primaria.
        </p>
      </div>
    </section>

    <!-- ═══ FUNCIONALIDADES ═══ -->
    <section class="py-20 px-6 sm:px-10 bg-slate-50">
      <div class="max-w-5xl mx-auto space-y-12">
        <h2 class="section-title text-center">Funcionalidades principales</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <div class="feature-card">
            <img src="/images/FeaturesStudios/Voxel_Construccion.png" alt="Construcción en cuadrícula" width="112" height="112" class="feature-img" loading="lazy" />
            <div class="feature-content">
              <h3 class="feature-title">Construcción en cuadrícula</h3>
              <p class="feature-desc">Sistema de grid inteligente con raycasting que detecta la superficie exacta donde colocar o eliminar el bloque. Arrastra para construir filas enteras de un solo gesto.</p>
            </div>
          </div>

          <div class="feature-card">
            <img src="/images/FeaturesStudios/Voxel_Paleta.png" alt="Paleta de 10 colores" width="112" height="112" class="feature-img" loading="lazy" />
            <div class="feature-content">
              <h3 class="feature-title">Paleta de 10 colores</h3>
              <p class="feature-desc">Incluye un azul semitransparente para simular agua o cristal. Selecciona el color antes de colocar y pinta bloques ya construidos con un solo clic.</p>
            </div>
          </div>

          <div class="feature-card">
            <img src="/images/FeaturesStudios/Voxel_Navegacion.png" alt="Navegación 3D unificada" width="112" height="112" class="feature-img" loading="lazy" />
            <div class="feature-content">
              <h3 class="feature-title">Navegación 3D unificada</h3>
              <p class="feature-desc">Órbita, zoom y paneo estándar, igual que en el resto de editores de la suite. Los alumnos aprenden una sola forma de moverse por el espacio 3D.</p>
            </div>
          </div>

          <div class="feature-card">
            <img src="/images/FeaturesStudios/Voxel_Guardado.png" alt="Guardado automático en la nube" width="112" height="112" class="feature-img" loading="lazy" />
            <div class="feature-content">
              <h3 class="feature-title">Guardado automático en la nube</h3>
              <p class="feature-desc">Cada vóxel se serializa como array de posición y color y se guarda en la cuenta del alumno. Las miniaturas se generan automáticamente para el panel del profesor.</p>
            </div>
          </div>

          <div class="md:col-span-2 bg-[#007AFB] rounded-2xl p-6 flex gap-5 items-start">
            <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
              <p class="text-[11px] font-black uppercase tracking-widest text-blue-200 mb-1">Parte de la suite Codemaker3D</p>
              <h3 class="text-lg font-bold text-white">Gestión centralizada de clases y alumnos</h3>
              <p class="text-blue-100 text-sm leading-relaxed mt-1">Este studio se gestiona desde un único dashboard junto al resto de herramientas de la suite. Activa o desactiva studios por clase, asigna actividades, revisa y califica proyectos en 3D — todo desde un solo lugar. Los alumnos acceden solo con un código de clase, sin email ni cuenta propia.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ VALOR PEDAGÓGICO ═══ -->
    <section class="py-20 px-6 sm:px-10 bg-white">
      <div class="max-w-5xl mx-auto space-y-14">
        <div class="text-center space-y-3">
          <h2 class="section-title">Valor pedagógico</h2>
          <p class="text-slate-500 max-w-2xl mx-auto">Competencias curriculares que trabaja este editor, alineadas con los objetivos de Educación Primaria y Primer Ciclo de ESO.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

          <div class="pedagogy-card">
            <div class="pedagogy-icon bg-blue-50 text-[#007AFB] border-blue-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12a10 10 0 1 0 20 0 10 10 0 0 0-20 0"/><path d="M12 2v20"/><path d="M2 12h20"/></svg>
            </div>
            <h4 class="pedagogy-title">Pensamiento espacial</h4>
            <p class="pedagogy-desc">Trabajar en tres dimensiones desarrolla la inteligencia espacial y la lateralidad, competencia clave en Matemáticas de Primaria (ejes X, Y, Z; orientación y posición relativa).</p>
          </div>

          <div class="pedagogy-card">
            <div class="pedagogy-icon bg-emerald-50 text-emerald-600 border-emerald-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
            </div>
            <h4 class="pedagogy-title">Creatividad sin barreras</h4>
            <p class="pedagogy-desc">Al eliminar la complejidad técnica del modelado poligonal, el alumno vuelca toda su energía en la idea y la composición, desarrollando la competencia artística y la expresión creativa.</p>
          </div>

          <div class="pedagogy-card">
            <div class="pedagogy-icon bg-purple-50 text-purple-600 border-purple-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
            </div>
            <h4 class="pedagogy-title">Cultura digital básica</h4>
            <p class="pedagogy-desc">El concepto de vóxel como «píxel 3D» introduce la representación discreta de la información. El alumno comprende cómo la imagen digital se construye desde unidades mínimas.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="py-20 px-6 sm:px-10 bg-slate-100">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-3xl md:text-4xl font-black text-slate-900 leading-tight">
          Lleva Voxel Studio a tu centro educativo
        </h2>
        <p class="text-lg text-slate-600">
          Nuestro equipo puede ayudarte a valorar cómo encaja Voxel Studio en tu programa de Primaria o en las primeras semanas de Tecnología.
        </p>
        <button class="contact-trigger btn-primary">
          Contacta con nosotros
        </button>
      </div>
    </section>

  </main>

  <Footer />
  <ContactModal />
</Layout>

<style>
  /* ─── Layout helpers ─── */
  .section-title  { @apply text-3xl md:text-4xl font-black text-slate-900; }

  /* ─── Chips ─── */
  .chip           { @apply text-[9px] px-2 py-0.5 rounded-md font-bold uppercase tracking-wider border; }
  .chip-slate     { @apply bg-slate-100 text-slate-600 border-slate-200; }
  .chip-emerald   { @apply bg-emerald-50 text-emerald-700 border-emerald-100; }
  .chip-amber     { @apply bg-amber-50 text-amber-700 border-amber-100; }
  .chip-rose      { @apply bg-rose-50 text-rose-700 border-rose-100; }
  .chip-purple    { @apply bg-purple-50 text-purple-600 border-purple-100; }
  .chip-indigo    { @apply bg-indigo-50 text-indigo-600 border-indigo-100; }
  .chip-blue      { @apply bg-blue-50 text-[#007AFB] border-blue-100; }

  /* ─── Buttons ─── */
  .btn-primary    { @apply inline-flex items-center justify-center px-8 py-4 rounded-2xl bg-[#007AFB] text-white font-bold hover:bg-[#00477A] transition-all shadow-lg shadow-blue-100 active:scale-95 text-lg; }
  .btn-primary-inv { @apply inline-flex items-center justify-center px-10 py-5 rounded-2xl bg-white text-[#007AFB] font-black hover:bg-slate-100 transition-all shadow-xl active:scale-95 text-xl; }

  /* ─── Feature cards ─── */
  .feature-card    { @apply bg-white rounded-2xl border border-slate-200 p-5 flex gap-5 items-start hover:shadow-md transition-shadow; }
  .feature-img     { @apply w-28 h-28 object-cover rounded-xl flex-shrink-0; }
  .feature-content { @apply flex flex-col gap-1 min-w-0; }
  .feature-num     { @apply block text-xs font-black uppercase tracking-widest text-[#007AFB]; }
  .feature-title   { @apply text-lg font-bold text-slate-900; }
  .feature-desc    { @apply text-slate-600 leading-relaxed text-sm; }

  /* ─── Pedagogy cards ─── */
  .pedagogy-card  { @apply space-y-4 text-center; }
  .pedagogy-icon  { @apply size-16 rounded-2xl flex items-center justify-center mx-auto border; }
  .pedagogy-title { @apply text-xl font-bold text-slate-900; }
  .pedagogy-desc  { @apply text-slate-600 leading-relaxed text-sm; }

  /* ─── Backgrounds ─── */
  .patron-puntos {
    background-image: radial-gradient(rgba(0,122,251,0.10) 1.5px, transparent 1.5px);
    background-size: 20px 20px;
  }

  /* ─── Animated borders ─── */
  .shiny-border-3d {
    background: linear-gradient(135deg, #64748b 10%, #C084FC 90%);
    background-size: 400%;
    animation: shine 6s linear infinite;
  }
  .shiny-border-code {
    background: linear-gradient(135deg, #64748b 10%, #007AFB 90%);
    background-size: 400%;
    animation: shine 6s linear infinite;
  }
  @keyframes shine {
    0%         { background-position: 100% 50%; }
    30%, 70%   { background-position:   0% 50%; }
    100%       { background-position: 100% 50%; }
  }
</style>
