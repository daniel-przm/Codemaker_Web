<script>
  // ── Carrusel del hero: cambiar captura + auto-rotación hasta que el usuario toque ──
  const shots = document.querySelectorAll<HTMLImageElement>('.studio-shot');
  const shotsContainer = document.getElementById('hero-shots-container');
  const studioNameEl = document.getElementById('hero-studio-name');
  const order = Array.from(shots).map((s) => s.dataset.shot!);
  let current = 0;
  let userTouched = false;

  function activate(id: string) {
    shots.forEach((s) => {
      const isActive = s.dataset.shot === id;
      s.classList.toggle('studio-shot-active', isActive);
      if (isActive && studioNameEl) studioNameEl.textContent = s.dataset.name ?? '';
    });
    current = order.indexOf(id);
  }

  shotsContainer?.addEventListener('click', () => {
    userTouched = true;
    activate(order[(current + 1) % order.length]);
  });

  // ── Carrusel de proyectos (sección 4): botones + avance automático ──
  const creationsTrack = document.getElementById('creations-track') as HTMLElement | null;

  function creationsStep(direction: 1 | -1) {
    if (!creationsTrack) return;
    const atEnd = creationsTrack.scrollLeft + creationsTrack.clientWidth >= creationsTrack.scrollWidth - 4;
    const atStart = creationsTrack.scrollLeft <= 4;

    if (direction === 1 && atEnd) {
      creationsTrack.scrollTo({ left: 0, behavior: 'smooth' });
    } else if (direction === -1 && atStart) {
      creationsTrack.scrollTo({ left: creationsTrack.scrollWidth, behavior: 'smooth' });
    } else {
      creationsTrack.scrollBy({ left: direction * creationsTrack.clientWidth * 0.85, behavior: 'smooth' });
    }
  }

  let creationsAutoAdvance = setInterval(() => creationsStep(1), 4000);

  document.getElementById('creations-prev')?.addEventListener('click', () => {
    clearInterval(creationsAutoAdvance);
    creationsStep(-1);
  });
  document.getElementById('creations-next')?.addEventListener('click', () => {
    clearInterval(creationsAutoAdvance);
    creationsStep(1);
  });

  const autoRotate = setInterval(() => {
    if (userTouched) {
      clearInterval(autoRotate);
      return;
    }
    activate(order[(current + 1) % order.length]);
  }, 4000);

  // ── Aparición al hacer scroll ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

  // ── FAQ en acordeón: colapsadas por defecto, una abierta a la vez ──
  const faqItems = document.querySelectorAll('.faq-item');

  faqItems.forEach((item) => {
    const trigger = item.querySelector('.faq-trigger');
    const content = item.querySelector('.faq-content') as HTMLElement;
    const icon = item.querySelector('svg');

    trigger?.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      faqItems.forEach((otherItem) => {
        if (otherItem !== item) {
          const otherTrigger = otherItem.querySelector('.faq-trigger');
          const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
          const otherIcon = otherItem.querySelector('svg');

          otherTrigger?.setAttribute('aria-expanded', 'false');
          otherContent.style.maxHeight = '0px';
          otherContent.style.opacity = '0';
          otherIcon?.classList.remove('rotate-180');
        }
      });

      trigger.setAttribute('aria-expanded', !isOpen ? 'true' : 'false');
      if (!isOpen) {
        content.style.maxHeight = content.scrollHeight + 'px';
        content.style.opacity = '1';
        icon?.classList.add('rotate-180');
      } else {
        content.style.maxHeight = '0px';
        content.style.opacity = '0';
        icon?.classList.remove('rotate-180');
      }
    });
  });

  // ── Modal de centros asociados (sección 5) ──
  const overlay = document.getElementById('modal-overlay');
  const container = document.getElementById('modal-container');
  const closeBtn = document.getElementById('close-modal');
  const openCentrosBtn = document.getElementById('open-centros');

  function openModal() {
    overlay?.classList.remove('hidden');
    overlay?.classList.add('flex');

    setTimeout(() => {
      container?.classList.remove('scale-95', 'opacity-0');
      container?.classList.add('scale-100', 'opacity-100');
    }, 10);

    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    container?.classList.remove('scale-100', 'opacity-100');
    container?.classList.add('scale-95', 'opacity-0');

    setTimeout(() => {
      overlay?.classList.add('hidden');
      overlay?.classList.remove('flex');
    }, 300);

    document.body.style.overflow = '';
  }

  openCentrosBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay?.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
