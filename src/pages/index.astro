---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import TecnologiasSlide from '../components/TecnologiasSlide.astro';
import { getSchools, getCentrosAsociados } from '../lib/schools';

// Modal "Centros asociados" — solo los cursos activos este curso, sin mapa
const cursosActivos = (await getSchools()).filter((s) => s.status === 'live');
const centrosAsociados = await getCentrosAsociados();

// Editores mostrados en el carrusel del hero
const studios = [
  { id: 'game', name: 'Game Studio', img: '/images/game3dstudio.png' },
  { id: 'voxel', name: 'Voxel Studio', img: '/images/voxelstudio.png' },
  { id: 'modeling', name: 'Modeling Studio', img: '/images/modelingstudio.png' },
  { id: 'form', name: 'Form Studio', img: '/images/formstudio.png' },
  { id: 'robotics', name: 'Robotics Studio', img: '/images/roboticsstudio.png' },
];

// Sección 2 — Apps de la suite (contenido original)
const tagStyles: Record<string, string> = {
  "Diseño 3D": "bg-purple-50 text-purple-600 border-purple-100",
  "Programación": "bg-indigo-50 text-indigo-600 border-indigo-100",
  "iniciación": "bg-emerald-50 text-emerald-700 border-emerald-100",
  "todos los niveles": "bg-rose-50 text-rose-700 border-rose-100",
};

const proyectos = [
  {
    src: "/images/voxelstudio.png",
    alt: "Voxel Studio",
    title: "Voxel Studio",
    href: "/editors/voxel-studio",
    tags: ["Diseño 3D", "iniciación"],
    description: "Crea mundos bloque a bloque. La forma más sencilla e intuitiva de dar los primeros pasos en 3D."
  },
  {
    src: "/images/modelingstudio.png",
    alt: "Modeling Studio",
    title: "Modeling Studio",
    href: "/editors/modeling-studio",
    tags: ["Diseño 3D", "todos los niveles"],
    description: "Modelado 3D con operaciones booleanas y planos técnicos en PDF. El editor más completo de la suite."
  },
  {
    src: "/images/formstudio.png",
    alt: "FormStudio",
    title: "FormStudio",
    href: "/editors/form-studio",
    tags: ["Diseño 3D", "todos los niveles"],
    description: "Modela formas orgánicas por subdivisión de superficies. Extruye, corta y suaviza caras como en Blender, en el navegador."
  },
  {
    src: "/images/game3dstudio.png",
    alt: "Game Studio",
    title: "Game Studio",
    href: "/editors/game-studio",
    tags: ["Programación", "todos los niveles"],
    description: "Diseña y programa videojuegos 3D con físicas reales. Blockly visual y motor Rapier para tus ideas."
  },
  {
    src: "/images/roboticsstudio.png",
    alt: "Robotics Studio",
    title: "Robotics Studio",
    href: "/editors/robotics-studio",
    tags: ["Programación", "todos los niveles"],
    description: "Programa un robot 3D con sensores y bloques visuales. Simulación completa sin necesidad de hardware."
  },
  {
    src: "",
    alt: "",
    title: "Próximamente",
    comingSoon: true,
    tags: [] as string[],
    description: "Nuevos editores sobre programación por código e Inteligencia Artificial en camino."
  },
];

// Sección 4 — proyectos de alumnos
const creations = [
  { img: '/images/Proyectos/Proyectos_GameStudio_EscapeRoom.png', studio: 'Game Studio', project: 'Escape Room', student: 'Laura M.' },
  { img: '/images/Proyectos/Proyectos_GameStudio_CiudadenObras.png', studio: 'Game Studio', project: 'Ciudad en Obras', student: 'Mateo R.' },
  { img: '/images/Proyectos/Proyectos_GameStudio_SimulandoFisicas.png', studio: 'Game Studio', project: 'Simulando Físicas', student: 'Diego S.' },
  { img: '/images/Proyectos/Proyectos_ModelingStudio_MesaySillas.png', studio: 'Modeling Studio', project: 'Mesa y Sillas', student: 'Sofía L.' },
  { img: '/images/Proyectos/Proyectos_ModelingStudio_ObjetosdeBaño.png', studio: 'Modeling Studio', project: 'Objetos de Baño', student: 'Alejandro P.' },
  { img: '/images/Proyectos/Proyectos_ModelingStudio_ObjetosdeClase.png', studio: 'Modeling Studio', project: 'Objetos de Clase', student: 'Marta G.' },
  { img: '/images/Proyectos/Proyectos_RoboticsStudio_Laberinto.png', studio: 'Robotics Studio', project: 'Laberinto', student: 'Pablo N.' },
  { img: '/images/Proyectos/Proyectos_RoboticsStudio_Siguelineas.png', studio: 'Robotics Studio', project: 'Sigue Líneas', student: 'Elena T.' },
];

// Sección 6 — FAQ, diferenciada por audiencia
const faqsAlumnos = [
  {
    q: "Soy un alumno/a interesado/a en aprender nuevas tecnologías, ¿qué puedo hacer?",
    a: "Puedes buscar un centro educativo donde se impartan nuestros cursos o apuntarte a nuestros grupos online."
  },
  {
    q: "Si me matriculo en vuestros cursos, ¿cómo accedo a vuestras apps?",
    a: "Una vez matriculado, tu profesor/a te dará acceso a todas las apps que vayáis necesitando durante el curso."
  },
];

const faqsProfesores = [
  {
    q: "Soy un profesor/a de un centro educativo, ¿qué hago para poder usar vuestras apps?",
    a: "Puedes adquirir una licencia de uso de las apps para que los propios profes del centro puedan usarlas en asignaturas tecnológicas, programas extracurriculares, etc., o contactar con nosotros para obtener una formación y consultoría personalizada."
  },
  {
    q: "¿Necesito saber programar o modelar para usar los editores?",
    a: "No. Los editores están pensados para ser intuitivos desde el primer momento, aunque como toda herramienta creativa lleva su tiempo dominarlos del todo. La biblioteca trae proyectos guiados paso a paso, y muchos de los profes que los usan no vienen del área de tecnología."
  },
  {
    q: "¿Funciona en los ordenadores de mi centro?",
    a: "Si tienen un navegador actualizado, sí. No se instala nada y no hace falta un equipo potente: lo usamos a diario en portátiles de aula normales y corrientes."
  },
  {
    q: "¿Mis alumnos necesitan correo electrónico?",
    a: "No. Entran con el código de tu clase y su nombre de usuario. Ni emails, ni datos personales de más, ni contraseñas que restablecer cada semana."
  },
  {
    q: "¿Y si lo quiero para todo mi centro?",
    a: "Hablamos, vemos cuántos docentes y grupos sois, y te preparamos una propuesta con factura para el centro. También hacemos formación inicial para el claustro si os hace falta."
  },
];
---

<Layout
  title="Tecnología educativa"
  brandFirst={true}
  description="Programación, robótica, diseño 3D e inteligencia artificial. Cursos, centros asociados y la suite de apps de Codemaker, todo en un mismo sitio."
>
  <Nav />
  <ContactModal />

  <main class="bg-white text-slate-900 overflow-x-clip">

    <!-- ═══════════════ SECCIÓN 1 · HERO ═══════════════ -->
    <section class="hero-blue relative pt-36 pb-16 px-6 sm:px-10 overflow-hidden">
      <div class="hero-3d-floor" aria-hidden="true"></div>

      <div class="max-w-5xl mx-auto relative space-y-10">
        <div class="flex flex-col lg:flex-row items-stretch gap-10">

          <!-- Texto -->
          <div class="flex flex-col lg:justify-between gap-6 items-start w-full lg:w-1/2 text-left" data-reveal>
            <img
              src="/svg/Logo.svg"
              alt="Codemaker Logo"
              class="h-20 md:h-24 w-auto object-contain"
            />
            <h1 class="text-lg md:text-2xl font-normal text-white leading-relaxed">
              Software educativo y formación en programación, robótica y 3D
            </h1>

            <div class="grid grid-cols-3 gap-3 max-w-md">
              <a href="https://3d.codemaker.es/login/student" class="door-btn door-btn-student">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                <span>Acceso alumnos/as</span>
              </a>
              <a href="https://3d.codemaker.es/login/teacher" class="door-btn door-btn-teacher">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>Acceso profes</span>
              </a>
              <a href="#cursos" class="door-btn door-btn-courses">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                <span>Buscar cursos</span>
              </a>
            </div>
          </div>

          <!-- Carrusel de la suite -->
          <div class="relative w-full lg:w-1/2" data-reveal style="--reveal-delay: 120ms">
            <div class="rounded-2xl border border-white/15 bg-slate-950 shadow-2xl shadow-black/30 overflow-hidden">
              <div class="flex items-center justify-between gap-2 px-4 py-3 bg-slate-900">
                <span id="hero-studio-name" class="text-xs font-bold text-slate-200 tracking-wide">
                  {studios[0].name}
                </span>
                <div class="flex items-center gap-1.5 shrink-0">
                  <span class="size-2.5 rounded-full bg-rose-400/80"></span>
                  <span class="size-2.5 rounded-full bg-amber-400/80"></span>
                  <span class="size-2.5 rounded-full bg-emerald-400/80"></span>
                </div>
              </div>

              <div id="hero-shots-container" class="relative aspect-[1.88] bg-slate-950 cursor-pointer">
                {studios.map((s, i) => (
                  <img
                    src={s.img}
                    alt={`Captura de ${s.name}`}
                    oncontextmenu="return false;"
                    class={`studio-shot absolute inset-0 w-full h-full object-cover ${i === 0 ? 'studio-shot-active' : ''}`}
                    data-shot={s.id}
                    data-name={s.name}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                ))}
              </div>
            </div>
          </div>

        </div>

        <div class="pt-2 tech-slide-wrap" data-reveal style="--reveal-delay: 200ms">
          <TecnologiasSlide />
        </div>
      </div>
    </section>

    <!-- ═══════════════ SECCIÓN 2 · NUESTRAS APPS (original) ═══════════════ -->
    <section id="apps" class="bg-white w-full py-20 px-6 sm:px-10 border-t border-slate-100 text-slate-900 patron-puntos">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="eyebrow text-[#007AFB] mb-3">Nuestras APPs</p>
          <h2 class="text-3xl md:text-5xl font-extrabold leading-tight text-slate-900">
            Herramientas interactivas para el aprendizaje
          </h2>
        </div>
        <p class="text-md md:text-lg text-center">
          En Codemaker hemos desarrollado una completa suite de aplicaciones educativas para fomentar el aprendizaje de tecnologías como la
          <span class="font-bold text-purple-500">programación, desarrollo de videojuegos, modelado 3D y robótica</span>,
          adaptadas a todos las edades y niveles educativos, inspiradas en aplicaciones profesionales como
          <span class="font-bold text-fuchsia-500">Blender, Unity o VSCode</span>
          con las que creamos una experiencia de aprendizaje interactiva y atractiva para los alumnos a la vez que adquieren capacidades claves del siglo XXI.
        </p>

        <div class="border-t border-slate-100 mt-8 mb-8"></div>
        <h3 class="text-xl font-bold text-slate-900 mb-6 text-center">
          Apps incluidas en nuestra suite educativa:
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {proyectos.map((proyecto) => (
            <div class="flex flex-col items-center text-center space-y-4 group">
              <div class="w-full rounded-2xl overflow-hidden shadow-md group-hover:shadow-xl transition-all duration-300 transform group-hover:-translate-y-2">
                <div class="relative rounded-2xl p-[2px] shiny-sec-border-dev">
                  <div class="rounded-[0.9rem] overflow-hidden bg-slate-950 aspect-video relative">
                    {proyecto.src && (
                      <img
                        src={proyecto.src}
                        alt={proyecto.alt}
                        oncontextmenu="return false;"
                        class={`w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 ${proyecto.comingSoon ? 'opacity-50 grayscale' : ''}`}
                        loading="lazy"
                      />
                    )}
                    {proyecto.comingSoon && (
                      <div class="absolute inset-0 flex items-center justify-center">
                        <span class="text-white font-bold text-xs bg-slate-900/80 px-4 py-1.5 rounded-full uppercase tracking-widest border border-white/20">
                          En desarrollo
                        </span>
                      </div>
                    )}
                    <div class="absolute inset-0 bg-slate-950/40 group-hover:bg-slate-950/10 transition-colors pointer-events-none"></div>
                  </div>
                </div>
              </div>

              <div class="flex flex-col items-center gap-3 w-full px-2">
                <div class="space-y-1">
                  <h4 class="text-base font-bold text-slate-800 uppercase tracking-wide">
                    {proyecto.title}
                  </h4>
                  <div class="flex flex-wrap items-center justify-center gap-1.5 min-h-[20px]">
                    {proyecto.tags.map((tag) => {
                      const style = tagStyles[tag] || "bg-gray-100 text-gray-600 border-gray-200";
                      return (
                        <span class={`text-[9px] px-2 py-0.5 rounded-md font-bold uppercase tracking-wider border ${style}`}>
                          {tag}
                        </span>
                      );
                    })}
                  </div>
                </div>

                <p class="text-xs text-slate-500 line-clamp-3 px-2 min-h-[3rem] flex items-center justify-center">
                  {proyecto.description}
                </p>

                {proyecto.comingSoon ? (
                  <span class="text-[10px] uppercase font-bold px-5 py-2 rounded-xl border-2 border-slate-200 text-slate-400 cursor-default bg-slate-50/50 mt-auto">
                    Próximamente
                  </span>
                ) : (
                  <a
                    href={proyecto.href}
                    class="text-[10px] uppercase font-bold px-6 py-2 rounded-xl border-2 border-[#007AFB] text-[#007AFB] hover:bg-[#007AFB] hover:text-white transition-all duration-300 active:scale-95 shadow-sm bg-white mt-auto"
                  >
                    Ver más
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════ SECCIÓN 3 · GESTIÓN DEL AULA (original, tal cual) ═══════════════ -->
    <section class="py-20 px-6 sm:px-10 bg-slate-50 border-b border-slate-100">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] items-stretch w-full gap-12">
          <!-- Columna izquierda: listado de funcionalidades -->
          <div class="space-y-6" data-reveal>
            <div>
              <h2 class="text-xl font-bold text-slate-900">
                Una plataforma educativa completa, no solo editores
              </h2>
              <p class="text-sm text-slate-500 mt-1">Gestión de aulas, evaluación y gamificación integrados desde el primer día.</p>
            </div>
            <ul class="space-y-5">
              <li class="flex items-start gap-4">
                <div class="mt-0.5 p-2 rounded-lg bg-blue-50 text-[#007AFB] shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div>
                  <p class="font-bold text-slate-800">Gestión de aulas y alumnos</p>
                  <p class="text-sm text-slate-500 mt-0.5">Crea clases, añade alumnos y configura qué editores están disponibles para cada grupo. Los alumnos acceden con código de clase, sin necesidad de correo electrónico. Puedes asignar actividades preestablecidas o dejar que abran proyectos libres.</p>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="mt-0.5 p-2 rounded-lg bg-emerald-50 text-emerald-600 shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                </div>
                <div>
                  <p class="font-bold text-slate-800">Calificación de proyectos en 3D</p>
                  <p class="text-sm text-slate-500 mt-0.5">Explora los proyectos de tus alumnos/as, califícalos y añade un comentario de feedback.</p>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="mt-0.5 p-2 rounded-lg bg-amber-50 text-amber-600 shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                </div>
                <div>
                  <p class="font-bold text-slate-800">Insignias por competencias</p>
                  <p class="text-sm text-slate-500 mt-0.5">El profesor/a puede otorgar insignias como Creatividad, Trabajo en equipo, etc. Alineadas con las competencias clave del currículo LOMLOE.</p>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="mt-0.5 p-2 rounded-lg bg-purple-50 text-purple-600 shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5z"/><path d="M8 7h6M8 11h8M8 15h5"/></svg>
                </div>
                <div>
                  <p class="font-bold text-slate-800">Biblioteca de tutoriales y proyectos curriculares</p>
                  <p class="text-sm text-slate-500 mt-0.5">Proyectos ya desarrollados y listos para el aula, filtrables por asignatura, etapa educativa, dificultad y editor. Diseñados y alineados con el currículo para que el profesor llegue, abra y empiece.</p>
                </div>
              </li>
            </ul>
          </div>

          <!-- Columna derecha: licencias -->
          <div class="bg-white p-8 md:p-10 rounded-[2.5rem] border border-slate-200 flex flex-col justify-center gap-8 shadow-sm" data-reveal style="--reveal-delay: 100ms">
            <p class="text-xl md:text-2xl text-slate-700 leading-relaxed font-medium">
              Contacta con nosotros para implementar estas herramientas en tu centro de forma profesional o pruébalas <span class="text-[#007AFB] font-black">gratis</span> ahora mismo.
            </p>
            <div class="flex flex-col gap-4">
              <a
                href="/licencias"
                class="flex-1 inline-flex justify-center items-center text-[#007AFB] px-8 py-4 rounded-2xl bg-white border-2 border-[#007AFB] hover:bg-slate-50 font-bold transition-all shadow-sm active:scale-95 text-lg"
              >
                Ver licencias
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="ml-2 size-5">
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ SECCIÓN 4 · PROYECTOS DE ALUMNOS ═══════════════ -->
    <section class="relative section-navy text-white py-24 px-6 sm:px-10 overflow-hidden">
      <div class="absolute inset-0 opacity-[0.07] pointer-events-none paper-grid-dark"></div>
      <div class="max-w-6xl mx-auto relative">
        <div class="max-w-2xl mx-auto text-center" data-reveal>
          <p class="eyebrow text-amber-400 mb-3">proyectos</p>
          <h2 class="text-3xl md:text-5xl font-extrabold leading-tight">
            Algunos proyectos creados por alumnos en nuestras apps.
          </h2>
          <p class="mt-4 text-lg text-slate-300 leading-relaxed">
            Así se ve la suite y sus diferentes apps cuando se usa en clase.
          </p>
        </div>

        <div class="relative mt-16">
          <button id="creations-prev" class="carousel-nav-btn left-1 sm:left-2" aria-label="Anterior">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button id="creations-next" class="carousel-nav-btn right-1 sm:right-2" aria-label="Siguiente">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>

          <div id="creations-track" class="creations-track flex gap-5 overflow-x-auto scroll-smooth snap-x snap-mandatory scrollbar-hide">
            {creations.map((c, i) => (
              <figure class="creation-card creation-card-carousel shrink-0 snap-start" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
                <img src={c.img} alt={`${c.project}, proyecto de ${c.studio}`} oncontextmenu="return false;" loading="lazy" />
                <figcaption class="creation-caption">
                  <span class="creation-caption-studio">{c.studio}</span> — {c.project}
                  <span class="creation-caption-student">({c.student})</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ SECCIÓN 5 · CURSOS Y CENTROS ASOCIADOS (original) ═══════════════ -->
