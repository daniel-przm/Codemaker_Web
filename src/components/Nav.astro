---
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    class="fixed left-1/2 -translate-x-1/2 z-[100] bg-slate-950/80 border border-white/10 backdrop-blur-xl transition-all duration-500 ease-in-out top-6 w-[95%] rounded-full px-6 py-2 md:py-3"
  >
    <div class="flex justify-between items-center gap-4">
      <!-- Logo -->
      <a href="/" class="shrink-0 transition-transform hover:scale-105 active:scale-95">
        <img
          src="/svg/LogoInvertido.svg"
          alt="Codemaker Logo"
          class="h-5 md:h-6 w-auto object-contain"
        />
      </a>

      <!-- Navigation Links -->
      <div class="flex items-center gap-8 md:gap-12">
        <!-- Home Link -->
        <a
          href="/"
          class="flex flex-col items-center gap-1 text-slate-400 hover:text-white transition-all group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:scale-110"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span class="text-[10px] md:text-xs uppercase tracking-[0.15em] opacity-80 group-hover:opacity-100">Home</span>
        </a>

        <!-- Entrar Link -->
        <a
          id="nav-entrar"
          href="https://3d.codemaker.es"
          class="flex flex-col items-center gap-1 text-slate-400 hover:text-[#007AFB] transition-all group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:scale-110"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          <span class="text-[10px] md:text-xs uppercase tracking-[0.15em] opacity-80 group-hover:opacity-100">Entrar</span>
        </a>
      </div>
    </div>
  </nav>
</div>

<!-- Modal: app no disponible en móvil -->
<div id="mobile-warning-modal" class="fixed inset-0 z-[200] hidden items-center justify-center p-6">
  <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm" id="mobile-warning-overlay"></div>
  <div
    id="mobile-warning-content"
    class="relative bg-slate-900 border border-white/10 w-full max-w-sm rounded-3xl shadow-2xl transform transition-all scale-95 opacity-0 duration-300 p-8 text-center"
  >
    <!-- Close button -->
    <button id="mobile-warning-close" class="absolute top-5 right-5 text-slate-500 hover:text-slate-300 transition-colors bg-slate-800 p-2 rounded-full hover:bg-slate-700" aria-label="Cerrar">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <!-- Icon -->
    <div class="flex items-center justify-center w-16 h-16 rounded-2xl bg-slate-800 border border-white/10 mx-auto mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#007AFB" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><circle cx="12" cy="17" r="1"/></svg>
    </div>

    <h3 class="text-xl font-bold text-white mb-3">App no disponible en móvil</h3>
    <p class="text-slate-400 text-sm leading-relaxed">
      Los editores de Codemaker están diseñados para pantallas grandes. Accede desde un <span class="text-white font-medium">ordenador o tablet</span> para disfrutar de la experiencia completa.
    </p>
  </div>
</div>

<style>
  #main-nav {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #main-nav.scrolling {
    background-color: rgba(0, 71, 122, 0.85);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.3);
  }
</style>

<script>
  const nav = document.getElementById("main-nav");

  function updateNav() {
    if (window.scrollY > 50) {
      nav?.classList.add("scrolling");
    } else {
      nav?.classList.remove("scrolling");
    }
  }

  window.addEventListener("scroll", updateNav, { passive: true });
  updateNav();

  // Mobile warning modal
  const modal = document.getElementById("mobile-warning-modal");
  const modalContent = document.getElementById("mobile-warning-content");
  const overlay = document.getElementById("mobile-warning-overlay");
  const closeBtn = document.getElementById("mobile-warning-close");
  const entrarLink = document.getElementById("nav-entrar");

  function openMobileWarning() {
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    setTimeout(() => {
      modalContent?.classList.remove("scale-95", "opacity-0");
      modalContent?.classList.add("scale-100", "opacity-100");
    }, 10);
    document.body.style.overflow = "hidden";
  }

  function closeMobileWarning() {
    modalContent?.classList.add("scale-95", "opacity-0");
    modalContent?.classList.remove("scale-100", "opacity-100");
    setTimeout(() => {
      modal?.classList.add("hidden");
      modal?.classList.remove("flex");
      document.body.style.overflow = "";
    }, 300);
  }

  entrarLink?.addEventListener("click", (e) => {
    // md breakpoint = 768px
    if (window.innerWidth < 768) {
      e.preventDefault();
      openMobileWarning();
    }
  });

  overlay?.addEventListener("click", closeMobileWarning);
  closeBtn?.addEventListener("click", closeMobileWarning);

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
      closeMobileWarning();
    }
  });
</script>
