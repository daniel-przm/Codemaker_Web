---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContactModal from '../../components/ContactModal.astro';
---

<Layout title="Robotics Studio">
  <Nav />

  <main class="bg-white min-h-screen text-slate-900 font-sans">

    <!-- ═══ HERO ═══ -->
    <section class="pt-32 pb-20 px-6 sm:px-10 border-b border-slate-100 patron-puntos">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-12">

        <div class="flex-1 space-y-6">
          <div class="flex flex-wrap gap-2">
            <span class="chip chip-indigo">Programación</span>
            <span class="chip chip-rose">todos los niveles</span>
          </div>
          <h1 class="text-4xl md:text-6xl font-black text-slate-900">
            Robotics <span class="text-[#007AFB]">Studio</span>
          </h1>
          <p class="text-xl text-slate-600 leading-relaxed font-medium max-w-xl">
            Programa un robot 3D con sensores reales en un simulador completo. Todo desde el navegador, sin necesidad de hardware físico.
          </p>
        </div>

        <div class="flex-1 w-full md:max-w-lg">
          <div class="relative rounded-2xl p-[2px] shiny-border-code shadow-2xl">
            <div class="rounded-[0.9rem] overflow-hidden bg-slate-950 aspect-video">
              <img src="/images/roboticsstudio.png" alt="Robotics Studio" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ═══ QUÉ ES ═══ -->
    <section class="relative overflow-hidden py-20 px-6 sm:px-10 border-b border-slate-100">
      <img src="/images/RoboticStudio_Background.png" alt="" aria-hidden="true"
           class="absolute inset-0 w-full h-full object-cover opacity-15 pointer-events-none select-none" />
      <div class="relative z-10 max-w-3xl mx-auto text-center space-y-6">
        <h2 class="section-title">¿Qué es Robotics Studio?</h2>
        <div class="w-16 h-1 bg-[#007AFB] mx-auto rounded-full"></div>
        <p class="text-lg text-slate-600 leading-relaxed">
          Robotics Studio es el simulador de robótica educativa de Codemaker3D. Los alumnos programan un robot virtual completo —con motores, <strong class="text-slate-800">sensores IR</strong>, sensor de distancia y <strong class="text-slate-800">matriz LED frontal</strong>— usando programación por bloques tipo Scratch, y lo prueban en un tablero editable con pistas siguelíneas, obstáculos y laberintos. Todo el ciclo de robótica ocurre en el navegador: sin robots físicos, sin cables, sin riesgo de avería.
        </p>
      </div>
    </section>

    <!-- ═══ FUNCIONALIDADES ═══ -->
    <section class="py-20 px-6 sm:px-10 bg-slate-50">
      <div class="max-w-5xl mx-auto space-y-12">
        <h2 class="section-title text-center">Funcionalidades principales</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <div class="feature-card">
            <img src="/images/FeaturesStudios/Robotics_Personalizacion.png" alt="Robot 3D personalizable" width="112" height="112" class="feature-img" loading="lazy" />
            <div class="feature-content">

              <h3 class="feature-title">Robot 3D personalizable</h3>
              <p class="feature-desc">Color del cuerpo y las ruedas a elección del alumno. Matriz LED frontal de 16×8 píxeles con editor visual interactivo y presets de expresiones. LEDs RGB de iluminación programables desde los bloques.</p>
            </div>
          </div>

          <div class="feature-card">
            <img src="/images/FeaturesStudios/Robotics_Terreno.png" alt="Tablero editable por baldosas" width="112" height="112" class="feature-img" loading="lazy" />
            <div class="feature-content">

              <h3 class="feature-title">Tablero editable por baldosas</h3>
              <p class="feature-desc">Diseña el circuito colocando suelo, muros, salida, meta y checkpoints. Pistas siguelíneas con rectas y curvas para crear cualquier circuito. Presets listos: Circuito siguelíneas y Laberinto.</p>
            </div>
          </div>

          <div class="feature-card">
            <img src="/images/FeaturesStudios/Robotics_Blocky.png" alt="Programación Blockly para robótica" width="112" height="112" class="feature-img" loading="lazy" />
            <div class="feature-content">

              <h3 class="feature-title">Programación Blockly para robótica</h3>
              <p class="feature-desc">Bloques específicos organizados por categorías: <strong>Movimiento</strong> (por pasos y preciso), <strong>Sensores</strong> (IR izq/der, distancia), <strong>LED</strong> (encender, matriz, expresiones) y <strong>Control</strong> (bucles, condicionales, esperar). Panel redimensionable.</p>
            </div>
          </div>

          <div class="feature-card">
            <img src="/images/FeaturesStudios/Robotics_Sensores.png" alt="Panel de sensores en tiempo real" width="112" height="112" class="feature-img" loading="lazy" />
            <div class="feature-content">

              <h3 class="feature-title">Panel de sensores en tiempo real</h3>
              <p class="feature-desc">Cámara POV (desde los ojos del robot) y cámara Selfie. Lectura en vivo de sensores IR izquierdo y derecho (Negro/Blanco), distancia al obstáculo en centímetros y estado actual de los LEDs.</p>
            </div>
          </div>

          <div class="md:col-span-2 bg-[#007AFB] rounded-2xl p-6 flex gap-5 items-start">
            <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
              <p class="text-[11px] font-black uppercase tracking-widest text-blue-200 mb-1">Parte de la suite Codemaker3D</p>
              <h3 class="text-lg font-bold text-white">Gestión centralizada de clases y alumnos</h3>
              <p class="text-blue-100 text-sm leading-relaxed mt-1">Este studio se gestiona desde un único dashboard junto al resto de herramientas de la suite. Activa o desactiva studios por clase, asigna actividades, revisa y califica proyectos en 3D — todo desde un solo lugar. Los alumnos acceden solo con un código de clase, sin email ni cuenta propia.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ VALOR PEDAGÓGICO ═══ -->
    <section class="py-20 px-6 sm:px-10 bg-white">
      <div class="max-w-5xl mx-auto space-y-14">
        <div class="text-center space-y-3">
          <h2 class="section-title">Valor pedagógico</h2>
          <p class="text-slate-500 max-w-2xl mx-auto">Competencias curriculares alineadas con Tecnología y Robótica en ESO, y con el bloque de Programación del currículo LOMLOE.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

          <div class="pedagogy-card">
            <div class="pedagogy-icon bg-blue-50 text-[#007AFB] border-blue-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16"/><line x1="16" y1="16" x2="16" y2="16"/></svg>
            </div>
            <h4 class="pedagogy-title">Fundamentos de robótica</h4>
            <p class="pedagogy-desc">Actuadores, sensores y lógica de control forman la base del currículo de Robótica en ESO. El alumno los maneja directamente, comprendiendo cómo los sistemas físicos reciben, procesan y responden a información.</p>
          </div>

          <div class="pedagogy-card">
            <div class="pedagogy-icon bg-emerald-50 text-emerald-600 border-emerald-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg>
            </div>
            <h4 class="pedagogy-title">Programación reactiva</h4>
            <p class="pedagogy-desc">Leer un sensor y actuar en consecuencia es la estructura «si / entonces» en su forma más pura. Los alumnos desarrollan el razonamiento condicional y aprenden a depurar su código cuando el robot no se comporta como esperaban.</p>
          </div>

          <div class="pedagogy-card">
            <div class="pedagogy-icon bg-purple-50 text-purple-600 border-purple-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h4 class="pedagogy-title">STEAM sin hardware</h4>
            <p class="pedagogy-desc">Robotics Studio democratiza el acceso a la robótica avanzada. Sin presupuesto en equipamiento, cualquier centro puede practicar algoritmos siguelíneas, laberintos y simulación de sensores con rigor científico.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="py-20 px-6 sm:px-10 bg-slate-100">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-3xl md:text-4xl font-black text-slate-900 leading-tight">
          Enseña robótica sin hardware ni presupuesto extra
        </h2>
        <p class="text-lg text-slate-600">
          Nuestro equipo puede orientarte sobre cómo usar Robotics Studio en el aula y cómo combinarlo con el bloque de Programación y Robótica del currículo.
        </p>
        <button class="contact-trigger btn-primary">
          Contacta con nosotros
        </button>
      </div>
    </section>

  </main>

  <Footer />
  <ContactModal />
</Layout>

<style>
  .section-title    { @apply text-3xl md:text-4xl font-black text-slate-900; }

  .chip             { @apply text-[9px] px-2 py-0.5 rounded-md font-bold uppercase tracking-wider border; }
  .chip-slate       { @apply bg-slate-100 text-slate-600 border-slate-200; }
  .chip-emerald     { @apply bg-emerald-50 text-emerald-700 border-emerald-100; }
  .chip-amber       { @apply bg-amber-50 text-amber-700 border-amber-100; }
  .chip-rose        { @apply bg-rose-50 text-rose-700 border-rose-100; }
  .chip-purple      { @apply bg-purple-50 text-purple-600 border-purple-100; }
  .chip-indigo      { @apply bg-indigo-50 text-indigo-600 border-indigo-100; }
  .chip-blue        { @apply bg-blue-50 text-[#007AFB] border-blue-100; }

  .btn-primary      { @apply inline-flex items-center justify-center px-8 py-4 rounded-2xl bg-[#007AFB] text-white font-bold hover:bg-[#00477A] transition-all shadow-lg shadow-blue-100 active:scale-95 text-lg; }
  .btn-primary-inv  { @apply inline-flex items-center justify-center px-10 py-5 rounded-2xl bg-white text-[#007AFB] font-black hover:bg-slate-100 transition-all shadow-xl active:scale-95 text-xl; }

  .feature-card    { @apply bg-white rounded-2xl border border-slate-200 p-5 flex gap-5 items-start hover:shadow-md transition-shadow; }
  .feature-img     { @apply w-28 h-28 object-cover rounded-xl flex-shrink-0; }
  .feature-content { @apply flex flex-col gap-1 min-w-0; }
  .feature-num     { @apply block text-xs font-black uppercase tracking-widest text-[#007AFB]; }
  .feature-title   { @apply text-lg font-bold text-slate-900; }
  .feature-desc    { @apply text-slate-600 leading-relaxed text-sm; }

  .pedagogy-card  { @apply space-y-4 text-center; }
  .pedagogy-icon  { @apply size-16 rounded-2xl flex items-center justify-center mx-auto border; }
  .pedagogy-title { @apply text-xl font-bold text-slate-900; }
  .pedagogy-desc  { @apply text-slate-600 leading-relaxed text-sm; }

  .patron-puntos {
    background-image: radial-gradient(rgba(0,122,251,0.10) 1.5px, transparent 1.5px);
    background-size: 20px 20px;
  }
  .shiny-border-code {
    background: linear-gradient(135deg, #64748b 10%, #007AFB 90%);
    background-size: 400%;
    animation: shine 6s linear infinite;
  }
  @keyframes shine {
    0%        { background-position: 100% 50%; }
    30%, 70%  { background-position:   0% 50%; }
    100%      { background-position: 100% 50%; }
  }
</style>
