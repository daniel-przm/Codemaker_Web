---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Home from "@/components/Home.astro";
import Colegios from "@/components/Colegios.astro";

---

<Layout title="Codemaker">
  <Nav />
  <Home />

  <section class="py-16 px-6 sm:px-10 bg-white patron-puntos">
    <div class="max-w-4xl mx-auto">
      <div class="rounded-2xl overflow-hidden shadow-xl border border-slate-200">
        <video
          src="/videos/presentacion-codemaker.mp4"
          autoplay
          muted
          loop
          playsinline
          class="w-full h-96 object-cover object-center"
        ></video>
      </div>
    </div>
  </section>

  <Colegios tipo="cursos" />

</Layout>

<style>
  .patron-puntos {
    background-image: radial-gradient(rgba(0, 122, 251, 0.15) 0.5px, transparent 0.5px);
    background-size: 10px 10px;
  }
</style>